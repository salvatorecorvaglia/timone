# Copy only if needed; Timone reads environment variables, not .env files directly.
TIMONE_MODE=local

# Development only: set TIMONE_ENV=development and TIMONE_MODE=demo for simulated data.
TIMONE_LISTEN=127.0.0.1:8080

# Required for incluster or any non-loopback listener: at least 32 random characters.
TIMONE_TOKEN=

# Alternative rotating file source; never configure both token settings.
TIMONE_TOKEN_FILE=
TIMONE_AUTH_MODE=token

# Only in proxy mode; direct gateway peer CIDRs, not forwarded client addresses.
TIMONE_TRUSTED_PROXIES=
TIMONE_ACCESS_LOG=true

# Local mode: standard kubeconfig path list, token/certificate or opt-in exec authentication.
KUBECONFIG=
TIMONE_CONTEXT=

# Run only trusted non-interactive kubeconfig credential plugins; provider CLI must be installed.
TIMONE_ALLOW_EXEC_AUTH=false

# Empty means context namespace, or all readable namespaces if context has none.
TIMONE_NAMESPACE=

# External origin behind a trusted TLS reverse proxy, e.g. https://timone.example.org
TIMONE_PUBLIC_URL=

# Explicitly decode safe Helm history summaries; also requires Secret list RBAC.
TIMONE_HELM_DETAILS=false

# Comma-separated explicit CRD names, maximum 32. Disabled by default in real modes.
# Requires get on each CRD and get/list on instances; only metadata/conditions shown.
TIMONE_CUSTOM_RESOURCES=

# Explicit historical-metrics opt-in; no automatic service endpoint is contacted.
TIMONE_PROMETHEUS_URL=

# HTTPS-only bearer credential file, re-read on each query. Never use URL credentials.
TIMONE_PROMETHEUS_TOKEN_FILE=

# Optional PEM CA bundle, read at startup. Default system roots remain trusted.
TIMONE_PROMETHEUS_CA_FILE=

# Exact 'cluster' label value for a shared Prometheus; empty requires a dedicated endpoint.
TIMONE_PROMETHEUS_CLUSTER=

# Explicitly permit unauthenticated HTTP to a trusted internal metrics endpoint.
TIMONE_PROMETHEUS_ALLOW_HTTP=false

# Administrator diagnostic policy; fixed until process restart. Whole integers only.
# Startup/readiness: 0..3600 seconds (0 evaluates age-gated signals immediately).
TIMONE_DIAGNOSTICS_STARTUP_GRACE_SECONDS=300

# Recent event-only signals: 60..86400 seconds; does not extend Kubernetes retention.
TIMONE_DIAGNOSTICS_WARNING_EVENT_WINDOW_SECONDS=900

# Cumulative restart count across Pod containers, 1..10000; not a rate.
TIMONE_DIAGNOSTICS_RESTART_THRESHOLD=5

# Optional HTTPS desired-manifest sources for explicit GitOps drift investigations.
TIMONE_ARGO_URL=
TIMONE_ARGO_TOKEN_FILE=
TIMONE_FLUX_RENDERED_URL=
TIMONE_FLUX_RENDERED_TOKEN_FILE=
TIMONE_GITOPS_CA_FILE=
TIMONE_GITOPS_DESTINATION=

# Optional Compose host port; 0 asks Docker for a free loopback port.
TIMONE_PORT=8080

# Optional direct trusted ingress peers for token-login X-Forwarded-For rate limits.
TIMONE_LOGIN_TRUSTED_PROXIES=

# Sanitized cache/informer retention in MiB (8-128); decoded heap and in-flight reads are additional.
TIMONE_RETAINED_MIB=16
