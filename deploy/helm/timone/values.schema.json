{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "auth",
    "image",
    "rbac",
    "helmDetails",
    "networkPolicy",
    "diagnostics"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "description": "One replica: browser sessions live in memory; HA is not implemented."
    },
    "auth": {
      "type": "object",
      "required": [
        "existingSecret",
        "mode",
        "trustedProxies"
      ],
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "token",
            "proxy"
          ]
        },
        "trustedProxies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "loginTrustedProxies": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "accessLog": {
      "type": "boolean"
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[0-9a-f]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "rbac": {
      "type": "object",
      "properties": {
        "discovery": {
          "type": "boolean"
        },
        "clusterResources": {
          "type": "boolean"
        },
        "secrets": {
          "type": "boolean"
        },
        "podLogs": {
          "type": "boolean"
        },
        "metrics": {
          "type": "boolean"
        },
        "subjectAccessReviews": {
          "type": "boolean"
        },
        "legacyNames": {
          "type": "boolean"
        }
      }
    },
    "helmDetails": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "publicURL": {
      "type": "string",
      "pattern": "^(https?://[^/?#@]+/?)?$"
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string"
        },
        "tls": {
          "type": "array"
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": [
        "enabled",
        "ingressPeers"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressPeers": {
          "type": "array",
          "items": {
            "type": "object",
            "minProperties": 1,
            "properties": {
              "namespaceSelector": {
                "type": "object"
              },
              "podSelector": {
                "type": "object"
              },
              "ipBlock": {
                "type": "object"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "customResources": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "group",
          "resource",
          "namespaced"
        ],
        "additionalProperties": false,
        "properties": {
          "group": {
            "type": "string",
            "maxLength": 190,
            "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$"
          },
          "resource": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z]([a-z0-9-]*[a-z0-9])?$"
          },
          "namespaced": {
            "type": "boolean"
          }
        }
      }
    },
    "prometheus": {
      "type": "object",
      "required": [
        "url",
        "cluster",
        "allowHTTP",
        "authSecret",
        "caConfigMap"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^(https?://[^/?#@%]+(/[^?#@%]*)?)?$"
        },
        "cluster": {
          "type": "string",
          "maxLength": 200
        },
        "allowHTTP": {
          "type": "boolean"
        },
        "authSecret": {
          "type": "string"
        },
        "caConfigMap": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startupGraceSeconds",
        "warningEventWindowSeconds",
        "restartThreshold"
      ],
      "properties": {
        "startupGraceSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "warningEventWindowSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "restartThreshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "gitops": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "argoURL": {
          "type": "string"
        },
        "fluxRenderedURL": {
          "type": "string"
        },
        "destination": {
          "type": "string"
        },
        "authSecret": {
          "type": "string"
        },
        "caConfigMap": {
          "type": "string"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$"
        }
      }
    },
    "retainedMiB": {
      "type": "integer",
      "minimum": 8,
      "maximum": 128
    }
  }
}
